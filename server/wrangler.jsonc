{
  "name": "drawing-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "preview_urls": true,
  "assets": {
    "directory": "../web/dist",
    "run_worker_first": ["/api/*", "/ws", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "BoardDO"
      },
      {
        "name": "BOARD_CATALOG",
        "class_name": "BoardCatalogDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BoardCatalogDO"]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "BOARD",
          "class_name": "BoardDO"
        },
        {
          "name": "BOARD_CATALOG",
          "class_name": "BoardCatalogDO"
        }
      ]
    }
  }
}
