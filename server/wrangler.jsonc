{
  "name": "drawing-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "BoardDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardDO"]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "BOARD",
          "class_name": "BoardDO"
        }
      ]
    }
  }
}
